# =============================================
# Evidence majetku - konfigurace prostredi
# =============================================
# Zkopirujte tento soubor jako `.env` a doplnte skutecne hodnoty.
# Soubor `.env` NIKDY nepatri do gitu (je v .gitignore) ani do deploye
# - na server (Wedos) se nahraje rucne pres FTP jednorazove.

# --- Aplikace ---
# production | development (development zapina vypis chyb na obrazovku)
APP_ENV=production
APP_URL=https://assets.ekospol.cz
# Tajny klic aplikace (podepisovani cookies/CSRF).
# Vygenerujte napr.:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Databaze (Wedos MariaDB) ---
DB_HOST=md391.wedos.net
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- E-mail ---
MAIL_FROM=assets@ekospol.cz
MAIL_FROM_NAME="Evidence majetku"

# --- Cron ---
# Tajny klic pro spousteni planovanych uloh pres URL:
# https://assets.ekospol.cz/cron/run?key=<CRON_KEY>
# Vygenerujte stejne jako APP_KEY (jiny retezec!).
CRON_KEY=
