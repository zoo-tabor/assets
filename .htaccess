# =====================================================================
# Evidence majetku EKOSPOL - assets.ekospol.cz (Wedos webhosting)
# Struktura dle overeneho vzoru VetApp Mobile (pravidla Wedos KB).
# POZOR: zadne php_flag/php_value - Wedos je blokuje (500).
# =====================================================================

RewriteEngine On

# --- 1) HTTPS redirect ------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 2) Security hlavicky --------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- 3) Deny citlivych souboru ---------------------------------------
<FilesMatch "(^\.env|^\.git|^\.ftp-deploy|^composer\.|\.(json|ini|log|sh|inc|bak|sql|md|lock|yml|yaml)$|^\.htaccess$)">
    Require all denied
</FilesMatch>

# --- 4) Zadne vypisy adresaru ----------------------------------------
Options -Indexes

# --- 5) Ochrana systemovych adresaru ---------------------------------
# Blokuje jen primy pristup k EXISTUJICIM souborum/adresarum,
# aby URL routy zacinajici stejne dal prochazely na index.php.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(app|migrations|data|tools)(/|$) - [F,L]

# --- 6) Cache statiky -------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf)$">
        Require all granted
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- 7) Fallback routing: vse ostatni na index.php --------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
